# ============================================================
# Tourist Safety Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ----------------------------------------------------------
# Database — PostgreSQL
# ----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tourist_safety
POSTGRES_USER=tourist_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://tourist_user:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/tourist_safety
DATABASE_URL_SYNC=postgresql+psycopg2://tourist_user:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/tourist_safety

# ----------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# Encryption (for sensitive user data at rest)
# ----------------------------------------------------------
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_BASE64_URLSAFE_32_BYTES

# ----------------------------------------------------------
# OpenWeatherMap
# ----------------------------------------------------------
OPENWEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY
WEATHER_MOCK_MODE=false

# ----------------------------------------------------------
# SMS Provider (Twilio-compatible)
# ----------------------------------------------------------
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
SMS_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
SMS_FROM_NUMBER=+1234567890
SMS_MOCK_MODE=false

# ----------------------------------------------------------
# Internet Alert Provider
# ----------------------------------------------------------
ALERT_PROVIDER_URL=https://your-alert-provider.example.com/notify
ALERT_PROVIDER_API_KEY=YOUR_ALERT_PROVIDER_API_KEY
ALERT_MOCK_MODE=false

# ----------------------------------------------------------
# Blockchain
# ----------------------------------------------------------
BLOCKCHAIN_PROVIDER_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_PRIVATE_KEY=CHANGE_ME_DEPLOYER_PRIVATE_KEY
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_MOCK_MODE=false

# ----------------------------------------------------------
# GPS Anomaly Detection — Configurable Defaults
# ----------------------------------------------------------
GPS_MOVEMENT_THRESHOLD_METERS=50
GPS_CHECK_INTERVAL_MINUTES=10
GPS_ANOMALY_LIMIT=3
GPS_ROUTE_DEVIATION_THRESHOLD_METERS=200
GPS_MAX_CONSECUTIVE_DEVIATIONS=3

# ----------------------------------------------------------
# Risk Engine Weights
# ----------------------------------------------------------
RISK_WEIGHT_WEATHER=0.3
RISK_WEIGHT_NEWS=0.4
RISK_WEIGHT_HISTORICAL=0.3

# ----------------------------------------------------------
# Adaptive Threshold
# ----------------------------------------------------------
ADAPTIVE_THRESHOLD_MIN=0.3
ADAPTIVE_THRESHOLD_MAX=0.9
ADAPTIVE_THRESHOLD_BASE=0.7

# ----------------------------------------------------------
# Audio Classification
# ----------------------------------------------------------
AUDIO_MODEL_PATH=models/audio/mobilenetv2_distress.pt
AUDIO_SAMPLE_RATE=22050
AUDIO_DURATION_SECONDS=3
AUDIO_N_MELS=128
AUDIO_HOP_LENGTH=512
AUDIO_MOCK_MODE=false

# ----------------------------------------------------------
# Background Workers
# ----------------------------------------------------------
WEATHER_UPDATE_INTERVAL_MINUTES=30
NEWS_UPDATE_INTERVAL_MINUTES=15
RISK_RECALC_INTERVAL_MINUTES=30
MESH_RETRY_INTERVAL_MINUTES=5
CLEANUP_INTERVAL_HOURS=6

# ----------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SOS_PER_MINUTE=10
